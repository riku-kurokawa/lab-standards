# ============================================================
# lab.toml — このプロジェクトの規約の唯一の設定源
#   labkit check / Claude Code の hooks がここを読む。変更は人間が行う（エージェントは自分を縛る規約を変えない。hooks が止める）。
#   ここに無いキーは labkit の既定値（labkit/config.py の DEFAULTS）。
# ============================================================

[lab]
project = "{{ project_slug }}"   # 生成元の版は .copier-answers.yml（standards_ref, _commit）

[layout]
# トップレベルに置いてよいもの（これ以外は L001）
allowed = [
  "README.md", "CLAUDE.md", "lab.toml", "pyproject.toml", "uv.lock", "Makefile",
  ".gitignore", ".gitattributes", ".pre-commit-config.yaml", ".copier-answers.yml", ".python-version",
  ".claude", ".git", ".venv", ".pytest_cache", ".ruff_cache", ".lab",
  "src", "scripts", "configs", "tests", "data", "runs", "notebooks",
  "figspecs", "jobs", "docs", "literature", "prompts", "scratch", "legacy",
]
# Claude が Write/Edit で直接書いてよい場所（data/ と runs/ はスクリプト経由でのみ生成）
writable = [
  "src", "scripts", "configs", "tests", "figspecs", "jobs", "docs", "literature", "prompts", "scratch", "notebooks",
  "README.md", "CLAUDE.md", "pyproject.toml", "Makefile", ".gitignore", ".gitattributes",
  ".claude/commands",  # プロジェクトのスラッシュコマンド（例: prompts/ のゴールを読む /goal）。settings.json は含めない
]
# 誰も書き換えない場所
readonly = ["data/raw", "legacy"]

[check]
mode = "strict"            # 移行中は "warn"（違反を表示するが失敗にしない）
plot_import_allowed = []   # 描画ライブラリを直接 import してよいファイル（glob）。原則空
format_allowed = []        # pickle 等を許すファイル（glob）。例: ["src/{{ package_name }}/models/checkpoint.py"]
skip = []                  # 一時的に無効化するチェックコード（例: ["L012"]）
max_file_lines = 300       # L018: src・scripts のファイルの行数（空行を除く）の上限（警告）。人間が一度に読める大きさ
max_lines_allowed = []     # 上限を外すファイル（glob）。理由を書く
dirty_citation = "warn"    # dirty な run を文書が結果として引用したとき（"warn" | "error"。claims.md は常に error）
archived_citation = "error" # 退避済みの run の数値の引用（L032。"error" | "warn"。ID だけの言及は警告）
undeclared_citation = "warn" # 比較とも非比較とも宣言していない指標の数値の引用（L027。claims.md は常に error）
# claim_docs = ["docs/**/*.md", "literature/surveys/*.md"]   # 引用を照合する文書（既定）

[compare]
# 比較は 1 軸だけを変える（labkit.compare）。required: すべての比較の [compare.<名>.common] が明示すべき条件の鍵。
# 無い・空なら run を始めない。以下は汎用の既定。**プロジェクトの分野の条件（例: 駆動の自由度 P/PG/PA、予測器、素子モデル、
# 遅延、場と力のモデル、幾何の規則）をここに列挙すること**（人間が決める。Claude は lab.toml を編集しない）
required = [
  "degrees_of_freedom",    # 各腕が動かせる自由度（例: 位相だけ / 位相と振幅）
  "inputs",                # 与える入力（目標・制約）
  "objective",             # 目的関数
  "model",                 # 予測器・物理モデル
  "precision",             # 数値精度・量子化
  "scoring",               # 採点関数
  "eval_set",              # 評価集合と分割
  "tuning_budget",         # 調整に使った構成の数
  "compute_budget",        # 反復数・時間の予算
  "normalisation",         # 正規化（電力・出力の定義）
]
# 対象外（目的を受け取れない手法）の独立した宣言。手法（軸の値）= [受け取れる目的]。設定の capability（著者の宣言）と食い違えば拒否
# [compare.capability]
# gs = ["focus"]

[state]
file = "docs/state.md"     # L037: H1 は 1 つ・同じ H2 は 1 回（error）、max_lines 超は警告。履歴は git に任せ、積み上げない
max_lines = 150

[digest]
file = "docs/DIGEST.md"    # 人間の入口 1 枚（`labkit digest`）。図は assets に写す
assets = "docs/assets/digest"
max_figures = 12

[devlog]
dir = "docs/devlog"
required_headings = ["目的", "結果・観察", "判断と理由", "未解決・次の作業"]
must_fill = ["目的", "判断と理由", "未解決・次の作業"]   # 空だと L030（終了時チェックが止める）

[adr]
dir = "docs/decisions"

[runs]
hash_max_gb = 2.0          # これより大きい入力・出力は sha256 を計算しない（MANIFEST/サイドカーの値は使う）
require_prediction = true  # 正式な run は設定の prediction（[prediction] basis と [[prediction.claims]]）が無いと始まらない。終了時に判定が残る
require_clean = true       # 未コミットの変更がある状態では run を始めない（dirty な run は結果として引用できない。試行は scratch/ で）

[literature]
pdf_dir = "literature/pdfs"   # 複数プロジェクトで共有するなら "~/lab-library/pdfs" など

[claude]
require_devlog = true      # コードを変更した日は開発ログの 目的・判断と理由・未解決 を書かないと終了できない
max_stop_blocks = 3        # 終了時チェックで止める最大回数（無限ループ防止）
allow_self_stop = false    # /loop を Claude が自分で止めること（CronDelete・ScheduleWakeup の stop）を許すか。止めるのは人間

[autonomy]
# 長い自律運用: backlog の未着手の項目（`- [ ] ...`）が min_open 件未満なら終了時チェックが止める（計算待ちで止まらない）
backlog = ""               # 例: "docs/backlog.md"。空で無効
min_open = 0
stall_beats = 3            # 判断と結果が（数字を除いて）同じで run の無い拍がこの回数続くと `labkit beat end` が記録を拒む。0 で無効
# 主線と芽（docs/mainline.md・docs/seeds.md）。主線に open の項目があるあいだだけ働く
main_share = 0.7           # 直近 main_window 拍のうち主線（--line main）の拍の下限。主線以外は floor((1-share)*window) 拍まで
main_window = 10
main_guard_hours = 12      # 期限切れか、期限までこの時間以内の open の主線があると、主線以外の拍は記録しない
seed_every = 8             # この拍数のあいだに芽（labkit seed add）が 1 つも無いと拍を閉じられない。0 で無効
fail_repeat = 3            # 同じ名前の run がこの回数続けて failed/interrupted で commit が進んでいなければ次を始めない。0 で無効
