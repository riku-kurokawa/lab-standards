# --- 生成物・大容量（再生成できるもの。正本の写しは `labkit mirror push`） ---
/data/*/*
!/data/*/.gitkeep
!/data/*/README.md
!/data/raw/MANIFEST.sha256
/runs/*
!/runs/.gitkeep
/scratch/*
!/scratch/.gitkeep

# --- ハーネスの手元だけの状態（flows/ は git 管理） ---
/.lab/queue/
/.lab/delegations.json
/.lab/mirror.json

# --- 文献（PDF は著作物・大容量なので管理外） ---
/literature/pdfs/*
!/literature/pdfs/.gitkeep
/literature/inbox/*
!/literature/inbox/.gitkeep

# --- 環境 ---
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
.claude/settings.local.json
