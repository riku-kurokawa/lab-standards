"""
    {{ julia_module }}

再利用ライブラリ（Julia）。純粋関数を置く。I/O・設定読込は jl/scripts 側、描画は labkit fig。
"""
module {{ julia_module }}

export moving_average, snr_db

"""
    moving_average(x, w)

窓幅 `w` の移動平均（端は短い窓）。
"""
function moving_average(x::AbstractVector{<:Real}, w::Integer)
    w >= 1 || throw(ArgumentError("w >= 1 が必要"))
    n = length(x)
    c = cumsum(vcat(zero(float(eltype(x))), x))
    h = w ÷ 2
    return [(c[min(n, i + h) + 1] - c[max(1, i - h)]) / (min(n, i + h) - max(1, i - h) + 1) for i in 1:n]
end

"""
    snr_db(clean, estimate)

推定誤差 `estimate - clean` に対する SNR [dB]。Python の `snr_db` と同じ定義。
"""
snr_db(clean::AbstractVector{<:Real}, estimate::AbstractVector{<:Real}) =
    10 * log10(sum(abs2, clean) / sum(abs2, estimate .- clean))

end # module
