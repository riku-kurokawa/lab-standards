# 例: Python の scripts/run_example.py と同じ設定ファイルで、移動平均を評価する
#   julia --project=jl jl/scripts/run_example.jl configs/experiments/example.toml [key=value ...]
using LabKit, Random
using {{ julia_module }}

function main(config_path, overrides)
    cfg = load_config(config_path; overrides=overrides)
    rng = MersenneTwister(cfg["seed"])
    run = Run(cfg["name"] * "-jl", cfg) do run
        s = cfg["signal"]
        t = collect(0:1/s["fs"]:s["duration_s"]-1/s["fs"])
        clean = sin.(2π * s["freq_hz"] .* t)
        noisy = clean .+ s["noise_std"] .* randn(rng, length(t))
        for (step, w) in enumerate([3, 9, 27, 81])
            est = moving_average(noisy, w)
            snr = 10 * log10(sum(abs2, clean) / sum(abs2, est .- clean))
            log_metric(run, "snr_db", snr; step=step - 1)
        end
        save(runpath(run, "signal.h5"),
             Dict("t" => t, "clean" => clean, "noisy" => noisy, "filtered" => moving_average(noisy, 27));
             attrs=Dict("fs" => s["fs"], "unit" => "a.u."), description="合成信号と移動平均")
    end
    println(run.run_id)
end

main(ARGS[1], ARGS[2:end])
