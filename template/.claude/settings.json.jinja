{
  "extraKnownMarketplaces": {
    "lab-standards": {
      "source": { "source": "github", "repo": "{{ standards_repo }}" }
    }
  },
  "enabledPlugins": {
    "lab-rules@lab-standards": true
  },
  "permissions": {
    "deny": [
      "Edit(data/raw/**)",
      "Edit(runs/**)",
      "Edit(lab.toml)",
      "Edit(.lab/approvals/**)",
      "Edit(.lab/queue/**)",
      "Edit(.lab/flows/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyWrite": ["data/raw", "lab.toml", ".lab/approvals", ".lab/queue", ".lab/flows"],
      "allowWrite": ["~/.cache/uv", "~/.local/share/uv", "~/.julia", "~/.cache/pre-commit"]
    },
    "network": {
      "allowedDomains": [
        "pypi.org", "files.pythonhosted.org",
        "github.com", "*.github.com", "objects.githubusercontent.com", "codeload.github.com",
        "pkg.julialang.org", "*.julialang.org", "julialang-s3.julialang.org",
        "astral.sh"
      ]
    }
  },
  "env": {
    "MLFLOW_DISABLE_TELEMETRY": "true",
    "DO_NOT_TRACK": "true"
  }
}
