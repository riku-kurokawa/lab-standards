{
  "extraKnownMarketplaces": {
    "lab-standards": {
      "source": { "source": "github", "repo": "{{ standards_repo }}" }
    }
  },
  "enabledPlugins": {
    "lab-rules@lab-standards": true
  },
  "permissions": {
    "deny": [
      "Edit(data/raw/**)",
      "Edit(runs/**)",
      "Edit(lab.toml)",
      "Edit(.lab/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyWrite": ["data/raw", "lab.toml", ".lab/queue", ".lab/delegations.json"],
      "allowWrite": ["~/.cache/uv", "~/.local/share/uv", "~/.cache/pre-commit"]
    },
    "network": {
      "allowedDomains": [
        "pypi.org", "files.pythonhosted.org",
        "github.com", "*.github.com", "objects.githubusercontent.com", "codeload.github.com",
        "astral.sh"
      ]
    }
  },
  "env": {
    "PYTHONUTF8": "1"
  }
}
