extends = "../base.toml"
name = "example-lowpass"
entry = "{{ package_name }}.experiments.example:run"   # 実行: uv run labkit run configs/experiments/example.toml [key=value ...]
# serves = "M001"   # どの線のための計算か（主線 Mxxx・芽 Sxxx・other:<理由>）。docs/mainline.md に open の項目があると必須

[signal]
noise_std = 0.8

# 計算する前に結果を予想する（run の終了時に自動で判定され、meta.json の prediction_result に残る）
[prediction]
basis = "雑音 0.8、最終カットオフ 20 Hz。信号 5 Hz は通り雑音の約 96 % を落とすので SNR は 10 dB 台。雑音の実現値で数 dB 動くので範囲で予想する"
expert_predictable = false  # 専門家なら計算せずに分かる結果なら true にし、なぜ計算が要るかを basis に書く（true の run は DIGEST に数が出る）
[[prediction.claims]]
key = "snr_db"
range = [8.0, 20.0]

# 事前に書いた合否（事後に基準を動かさない）。metrics の pass_1 / pass_all に残る
[[pass]]
key = "snr_db"
min = 8.0

# 指標の宣言（既定で拒否）: 主張の根拠にできるのは、ここで非比較と宣言した指標か、matched な比較（[compare.<名>] keys）の指標だけ
[report]
noncomparative = ["snr_db", "pass_*"]

# 腕（手法・設計・設定）を比べるなら、変える軸 1 つと腕を run の前に書く（labkit.compare。条件は common と腕の表から導出）
# [compare.lowpass]
# vary = "filter"                      # 変える軸はちょうど 1 つ
# keys = ["snr_gain_db"]               # この比較の指標
# better = "max"                       # 指標の良い向き（掃引の direction はこれと同じ）
# [compare.lowpass.common]             # 全腕で同一の条件（lab.toml の [compare] required をすべて含む）
# eval_set = "synthetic-v1"
# [compare.lowpass.arms.butter]
# filter = "butter"                    # 軸の値は 1 語で腕の名前（か levels = [...] の値）。[compare] の外に腕の名前の鍵を置かない
# [compare.lowpass.arms.moving]
# filter = "moving"
# [[compare.lowpass.sweep]]            # 自由パラメータは掃引の最良。1 腕でも調整するなら全腕を同じ総試行数で
# arm = "moving"
# param = "window"
# values = [3, 5, 9]
# metric = "snr_gain_db_moving_w{value}"   # 比較の指標を含む名前
# direction = "max"
# [[compare.lowpass.sweep]]
# arm = "butter"
# param = "order"
# values = [2, 4, 6]
# metric = "snr_gain_db_butter_o{value}"
# direction = "max"
