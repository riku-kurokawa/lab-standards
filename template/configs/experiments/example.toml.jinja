extends = "../base.toml"
name = "example-lowpass"
entry = "{{ package_name }}.experiments.example:run"   # 実行: uv run labkit run configs/experiments/example.toml [key=value ...]

[signal]
noise_std = 0.8

# 計算する前に結果を予想する（run の終了時に自動で判定され、meta.json の prediction_result に残る）
[prediction]
basis = "雑音 0.8、最終カットオフ 20 Hz。信号 5 Hz は通り雑音の約 96 % を落とすので SNR は 10 dB 台"
expert_predictable = true   # 専門家なら計算せずに分かる結果か。true なら、なぜ計算が要るか（ここでは動作確認）を basis に書く
[[prediction.claims]]
key = "snr_db"
range = [8.0, 20.0]

# 事前に書いた合否（事後に基準を動かさない）。metrics の pass_1 / pass_all に残る
[[pass]]
key = "snr_db"
min = 8.0
