[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
authors = [{ name = "{{ author }}" }]
requires-python = ">={{ python_version }}"
dependencies = [
  "labkit",
  "numpy",
  "scipy",
]

[project.optional-dependencies]
mlflow = ["labkit[mlflow]"]

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.5", "pre-commit>=3", "nbstripout>=0.7"]

[tool.uv.sources]
# lab-standards のバージョンを固定（更新は copier update と合わせて行う）
labkit = { git = "https://github.com/{{ standards_repo }}.git", tag = "{{ standards_ref }}", subdirectory = "labkit/python" }

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 120
target-version = "py{{ python_version | replace('.', '') }}"
extend-exclude = ["legacy", "scratch"]

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "NPY", "TID251"]
ignore = ["E501"]

[tool.ruff.lint.flake8-tidy-imports.banned-api]
"matplotlib".msg = "図は figspecs/*.toml + labkit fig で作る"
"pickle".msg = "HDF5/Parquet（labkit.save）を使う"
