{
  "description": "lab-standards: lab.toml のあるプロジェクトで成果物と台帳の保護・終了時の検証・主線と芽の状態の注入を行う（判定は labkit hook）。それ以外では何もしない",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.py", "session"], "timeout": 30 }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.py", "prompt"], "timeout": 15 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|CronDelete|ScheduleWakeup",
        "hooks": [{ "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.py", "pretool"], "timeout": 20 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.py", "stop"], "timeout": 300 }] }
    ]
  }
}
